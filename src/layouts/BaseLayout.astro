---
import '../styles/screen.css';

interface Props {
  title?: string;
}

const { title = 'heypr' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site">
      <div class="title">
        <a href="/">heypr</a>
        <a class="extra" href="https://github.com/heypr">github</a>
      </div>

      <slot />

      <div class="footer">
        <div class="contact">
          <p>
            heypr<br />
            <a href="https://github.com/heypr">github.com/heypr</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
